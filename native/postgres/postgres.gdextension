[configuration]

entry_symbol = "postgres_extension_init"
compatibility_minimum = "4.7"

[libraries]

windows.debug.x86_64 = "res://native/postgres/bin/windows/mmorpg3d_postgres.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/postgres/bin/windows/mmorpg3d_postgres.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://native/postgres/bin/linux/libmmorpg3d_postgres.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/postgres/bin/linux/libmmorpg3d_postgres.linux.template_release.x86_64.so"

[dependencies]

windows.debug.x86_64 = {
	"res://native/postgres/bin/windows/libpq.dll": "",
	"res://native/postgres/bin/windows/libintl-8.dll": "",
	"res://native/postgres/bin/windows/libiconv-2.dll": "",
	"res://native/postgres/bin/windows/libssl-3-x64.dll": "",
	"res://native/postgres/bin/windows/libcrypto-3-x64.dll": ""
}
windows.release.x86_64 = {
	"res://native/postgres/bin/windows/libpq.dll": "",
	"res://native/postgres/bin/windows/libintl-8.dll": "",
	"res://native/postgres/bin/windows/libiconv-2.dll": "",
	"res://native/postgres/bin/windows/libssl-3-x64.dll": "",
	"res://native/postgres/bin/windows/libcrypto-3-x64.dll": ""
}
